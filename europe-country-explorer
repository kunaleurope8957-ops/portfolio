const container = document.getElementById("countries");
const search = document.getElementById("search");

function displayCountries(list) {
      container.innerHTML = "";

        if (list.length === 0) {
                container.innerHTML = "<p>No countries found.</p>";
                    return;
        }

          list.forEach(country => {
                container.innerHTML += `
                      <div class="country-card">
                              <div class="flag">${country.flag}</div>
                                      <h3>${country.name}</h3>
                                              <p>🏙️ Capital: ${country.capital}</p>
                                                      <p>💶 Currency: ${country.currency}</p>
                                                              <p>🌍 Region: ${country.region}</p>
                                                                    </div>
                                                                        `;
          });
}

function showAll() {
      document.getElementById("heading").textContent = "European Countries";
        displayCountries(countries);
}

function showNordic() {
      document.getElementById("heading").textContent = "Nordic Countries";
        displayCountries(countries.filter(c => c.region === "Nordic"));
}

search.addEventListener("input", () => {
      const value = search.value.toLowerCase();
        displayCountries(
                countries.filter(c => c.name.toLowerCase().includes(value))
        );
});

