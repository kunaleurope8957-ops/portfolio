<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nordic Relocation Command Center | Kunal.NordicDev</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-gray-100 font-sans min-h-screen flex flex-col justify-between m-0 p-0">

  <!-- Header Section -->
  <header class="border-b border-gray-800 px-4 py-4 bg-gray-900/50 backdrop-blur sticky top-0 z-50">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
      <div class="flex items-center space-x-3">
        <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
        <h1 class="text-base sm:text-lg font-black tracking-wider text-white">NORDIC RELOCATION COMMAND CENTER</h1>
      </div>
      <div class="flex items-center space-x-2 text-xs">
        <span class="bg-emerald-950 text-emerald-400 border border-emerald-800 px-3 py-1 rounded-full font-bold">
          Target: Jan 15 Milestone 🎯
        </span>
      </div>
    </div>
  </header>

  <!-- Main Dashboard Container -->
  <main class="max-w-6xl mx-auto w-full px-4 py-8 flex-grow space-y-8">

    <!-- Hero Banner -->
    <div class="bg-gradient-to-r from-emerald-950 via-gray-900 to-gray-950 border border-emerald-800/40 rounded-2xl p-6 relative overflow-hidden">
      <div class="max-w-2xl relative z-10">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest bg-emerald-950/80 px-2.5 py-1 rounded border border-emerald-800">
          European Relocation Engine
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white mt-3">Targeting Nordic Tech Hubs (2027-2028)</h2>
        <p class="text-xs sm:text-sm text-gray-300 mt-2">
          Self-taught Junior Frontend Developer tracking relocation metrics for Denmark 🇩🇰, Finland 🇫🇮, Norway 🇳🇴, Sweden 🇸🇪 & Netherlands 🇳🇱.
        </p>
      </div>
    </div>

    <!-- Live Calculator & Engine Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Salary & Savings Simulator -->
      <div class="lg:col-span-2 bg-gray-900 border border-gray-800 rounded-2xl p-6 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <span>🧮</span> Interactive Savings Engine
            </h3>
            <span class="text-[10px] text-emerald-400 font-mono">Live Estimation</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            <div>
              <label class="text-xs font-semibold text-gray-400 block mb-1">Target Country & Currency</label>
              <select id="countrySelect" class="w-full bg-gray-950 border border-gray-800 text-white text-xs rounded-lg p-2.5 focus:border-emerald-500 outline-none">
                <option value="DKK">Denmark (DKK - Danish Krone)</option>
                <option value="EUR">Finland / Netherlands (€ - Euro)</option>
                <option value="NOK">Norway (NOK - Norwegian Krone)</option>
                <option value="SEK">Sweden (SEK - Swedish Krona)</option>
              </select>
            </div>
            <div>
              <label class="text-xs font-semibold text-gray-400 block mb-1">Gross Monthly Target Salary</label>
              <input type="number" id="salaryInput" value="45000" class="w-full bg-gray-950 border border-gray-800 text-white text-xs rounded-lg p-2.5 focus:border-emerald-500 outline-none">
            </div>
          </div>

          <!-- Breakdown Display -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <div class="bg-gray-950 border border-gray-800 p-3 rounded-xl">
              <span class="text-[10px] text-gray-400 block">Est. Tax Deduction</span>
              <span id="taxDisplay" class="text-sm font-bold text-red-400">~ 38%</span>
            </div>
            <div class="bg-gray-950 border border-gray-800 p-3 rounded-xl">
              <span class="text-[10px] text-gray-400 block">Est. Living Cost</span>
              <span id="costDisplay" class="text-sm font-bold text-yellow-400">~ 14,000</span>
            </div>
            <div class="bg-gray-950 border border-emerald-800/60 p-3 rounded-xl col-span-2 sm:col-span-1">
              <span class="text-[10px] text-emerald-400 block font-semibold">Net Monthly Savings</span>
              <span id="savingsDisplay" class="text-sm font-black text-emerald-400">~ 13,900 DKK</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-800 text-xs text-gray-400 flex justify-between items-center">
          <span>Estimated Monthly INR Savings:</span>
          <span id="inrSavings" class="text-sm font-bold text-emerald-400">₹1,68,000 / month</span>
        </div>
      </div>

      <!-- Roadmap Focus Card -->
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 flex flex-col justify-between">
        <div>
          <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
            <span>🚀</span> Mission Milestones
          </h3>
          <ul class="space-y-3 text-xs">
            <li class="flex items-start gap-2 bg-gray-950 p-3 rounded-xl border border-emerald-900/40">
              <span class="text-emerald-400 font-bold">✓</span>
              <div>
                <strong class="text-white block">Phase 1: Deep Work & Code</strong>
                <span class="text-gray-400 text-[11px]">Building core tools & Git Push consistency till Jan 15.</span>
              </div>
            </li>
            <li class="flex items-start gap-2 bg-gray-950 p-3 rounded-xl border border-gray-800">
              <span class="text-blue-400 font-bold">➔</span>
              <div>
                <strong class="text-white block">Phase 2: Passport & Outreach</strong>
                <span class="text-gray-400 text-[11px]">Passport application & direct employer pitch post-Jan 15.</span>
              </div>
            </li>
            <li class="flex items-start gap-2 bg-gray-950 p-3 rounded-xl border border-gray-800">
              <span class="text-yellow-400 font-bold">★</span>
              <div>
                <strong class="text-white block">Phase 3: Visa & Copenhagen</strong>
                <span class="text-gray-400 text-[11px]">Targeting fast-track work sponsorship.</span>
              </div>
            </li>
          </ul>
        </div>
        <div class="mt-4 pt-3 border-t border-gray-800 text-[11px] text-center text-gray-500">
          Age: 17 • Goal: Nordic Frontend Developer
        </div>
      </div>

    </div>

    <!-- 5-Nation Target Cards Grid -->
    <div>
      <h3 class="text-xl font-extrabold text-white mb-4 flex items-center gap-2">
        <span>🇪🇺</span> 5-Nation Tech Hub Radar
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <!-- Denmark -->
        <div class="bg-gray-900 border border-emerald-500/40 rounded-xl p-4 hover:border-emerald-500 transition">
          <div class="flex justify-between items-center mb-2">
            <span class="text-2xl">🇩🇰</span>
            <span class="text-[10px] bg-emerald-950 text-emerald-400 px-2 py-0.5 rounded font-bold">Top Priority</span>
          </div>
          <h4 class="text-base font-bold text-white">Denmark (Copenhagen)</h4>
          <p class="text-xs text-gray-400 mt-1">37 Hr Work Week • 38k - 45k DKK Target Salary • High Work-Life Balance.</p>
        </div>

        <!-- Finland -->
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 hover:border-emerald-500/40 transition">
          <div class="flex justify-between items-center mb-2">
            <span class="text-2xl">🇫🇮</span>
            <span class="text-[10px] bg-blue-950 text-blue-400 px-2 py-0.5 rounded font-bold">Tech Ecosystem</span>
          </div>
          <h4 class="text-base font-bold text-white">Finland (Helsinki)</h4>
          <p class="text-xs text-gray-400 mt-1">€3,800 - €4,500 Target Salary • World Class Education & Tech Infrastructure.</p>
        </div>

        <!-- Norway -->
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 hover:border-emerald-500/40 transition">
          <div class="flex justify-between items-center mb-2">
            <span class="text-2xl">🇳🇴</span>
            <span class="text-[10px] bg-red-950 text-red-400 px-2 py-0.5 rounded font-bold">High Quality</span>
          </div>
          <h4 class="text-base font-bold text-white">Norway (Oslo)</h4>
          <p class="text-xs text-gray-400 mt-1">42k - 50k NOK Target Salary • High Standard of Living & Scenic Nature.</p>
        </div>

        <!-- Sweden -->
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 hover:border-emerald-500/40 transition">
          <div class="flex justify-between items-center mb-2">
            <span class="text-2xl">🇸🇪</span>
            <span class="text-[10px] bg-yellow-950 text-yellow-400 px-2 py-0.5 rounded font-bold">Unicorn Startups</span>
          </div>
          <h4 class="text-base font-bold text-white">Sweden (Stockholm)</h4>
          <p class="text-xs text-gray-400 mt-1">40k - 48k SEK Target Salary • Massive Startup Market & Innovation Hub.</p>
        </div>

        <!-- Netherlands -->
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 hover:border-emerald-500/40 transition md:col-span-2">
          <div class="flex justify-between items-center mb-2">
            <span class="text-2xl">🇳🇱</span>
            <span class="text-[10px] bg-orange-950 text-orange-400 px-2 py-0.5 rounded font-bold">30% Tax Benefit</span>
          </div>
          <h4 class="text-base font-bold text-white">Netherlands (Amsterdam)</h4>
          <p class="text-xs text-gray-400 mt-1">€4,000 - €5,000 Target Salary • Extremely English-Friendly Tech Ecosystem.</p>
        </div>

      </div>
    </div>

    <!-- Back Navigation -->
    <div class="text-center pt-4">
      <a href="index.html" class="inline-block text-xs bg-emerald-500 hover:bg-emerald-600 text-gray-950 font-bold px-6 py-2.5 rounded-xl transition shadow-lg shadow-emerald-500/20">
        ← Back to Portfolio Hub
      </a>
    </div>

  </main>

  <!-- Footer -->
  <footer class="text-center py-4 text-xs text-gray-600 border-t border-gray-900 w-full">
    © 2026 Kunal.NordicDev • Copenhagen Relocation Masterplan
  </footer>

  <!-- Simple Dynamic JavaScript Script -->
  <script>
    const countrySelect = document.getElementById('countrySelect');
    const salaryInput = document.getElementById('salaryInput');
    const taxDisplay = document.getElementById('taxDisplay');
    const costDisplay = document.getElementById('costDisplay');
    const savingsDisplay = document.getElementById('savingsDisplay');
    const inrSavings = document.getElementById('inrSavings');

    function updateCalculator() {
      const currency = countrySelect.value;
      const gross = parseFloat(salaryInput.value) || 0;
      let netSavings = 0;
      let formattedINR = "";

      if (currency === 'DKK') {
        const afterTax = gross * 0.62;
        netSavings = afterTax - 14000;
        taxDisplay.textContent = '~ 38%';
        costDisplay.textContent = '14,000 DKK';
        savingsDisplay.textContent = `${Math.max(0, Math.round(netSavings)).toLocaleString()} DKK`;
        formattedINR = `₹${Math.max(0, Math.round(netSavings * 12.1)).toLocaleString()} / month`;
      } else if (currency === 'EUR') {
        const afterTax = gross * 0.65;
        netSavings = afterTax - 1600;
        taxDisplay.textContent = '~ 35%';
        costDisplay.textContent = '€1,600';
        savingsDisplay.textContent = `€${Math.max(0, Math.round(netSavings)).toLocaleString()}`;
        formattedINR = `₹${Math.max(0, Math.round(netSavings * 90)).toLocaleString()} / month`;
      } else if (currency === 'NOK') {
        const afterTax = gross * 0.64;
        netSavings = afterTax - 15000;
        taxDisplay.textContent = '~ 36%';
        costDisplay.textContent = '15,000 NOK';
        savingsDisplay.textContent = `${Math.max(0, Math.round(netSavings)).toLocaleString()} NOK`;
        formattedINR = `₹${Math.max(0, Math.round(netSavings * 7.8)).toLocaleString()} / month`;
      } else if (currency === 'SEK') {
        const afterTax = gross * 0.67;
        netSavings = afterTax - 14000;
        taxDisplay.textContent = '~ 33%';
        costDisplay.textContent = '14,000 SEK';
        savingsDisplay.textContent = `${Math.max(0, Math.round(netSavings)).toLocaleString()} SEK`;
        formattedINR = `₹${Math.max(0, Math.round(netSavings * 8.1)).toLocaleString()} / month`;
      }

      inrSavings.textContent = formattedINR;
    }

    countrySelect.addEventListener('change', updateCalculator);
    salaryInput.addEventListener('input', updateCalculator);
    updateCalculator();
  </script>

</body>
</html>
