        .header-flex { display: flex; justify-content: space-between; align-items: flex-start; }
        h1 { color: #0d6efd; margin-bottom: 5px; font-size: 2.2rem; margin-top: 0; }
        .subtitle { font-size: 1.15rem; color: var(--subtitle-color); margin-top: 0; font-weight: 500; }
        .flags-bar { font-size: 1.5rem; margin-top: 5px; letter-spacing: 3px; }
        .theme-btn { background: #0d6efd; color: white; border: none; padding: 8px 16px; border-radius: 20px; cursor: pointer; font-weight: bold; font-size: 0.9rem; flex-shrink: 0; }
        .visa-status { background: #e7f1ff; padding: 15px; border-left: 6px solid #d0001c; margin: 20px 0; border-radius: 4px; font-weight: 500; color: #212529; font-size: 0.95rem; line-height: 1.7; }
        [data-theme="dark"] .visa-status { background: rgba(6, 182, 212, 0.1); border-left-color: var(--matrix-glow); color: var(--text-color); }
        h2 { border-bottom: 2px solid var(--border-color); padding-bottom: 8px; color: var(--text-color); margin-top: 25px; font-size: 1.35rem; }
        ul { padding-left: 20px; }
        li { margin-bottom: 8px; font-size: 0.95rem; }
        
        /* Quantum Project Grid */
        .project-grid { display: grid; grid-template-columns: 1fr; gap: 15px; margin-top: 15px; }
        @media(min-width: 600px) { .project-grid { grid-template-columns: 1fr 1fr; } }
        .project-card { background: var(--card-bg); padding: 15px; border-radius: 8px; border: 1px solid var(--border-color); }
        .project-card h3 { margin-top: 0; color: #0d6efd; font-size: 1.1rem; }
        [data-theme="dark"] .project-card h3 { color: var(--matrix-glow); }
        .project-card p { font-size: 0.9rem; margin-bottom: 10px; color: var(--text-color); }
        .tag { background: #0d6efd; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; }
        
        /* Advanced Skill Matrix Bars */
