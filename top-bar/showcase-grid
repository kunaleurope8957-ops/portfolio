<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kunal.dev // Nordic Frontend & Systems Architect</title>
    <style>
        :root {
            --bg-base: #090d16;
            --surface-color: #131b2e;
            --accent-neon: #38bdf8;
            --accent-rose: #f43f5e;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --border-glow: #1e293b;
        }
        [data-theme="light"] {
            --bg-base: #f1f5f9;
            --surface-color: #ffffff;
            --accent-neon: #0284c7;
            --accent-rose: #e11d48;
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --border-glow: #cbd5e1;
        }
        body { font-family: 'Segoe UI', Arial, sans-serif; background-color: var(--bg-base); color: var(--text-primary); margin: 0; padding: 20px; line-height: 1.6; transition: background 0.3s ease; }
        .wrapper { max-width: 850px; margin: auto; background: var(--surface-color); padding: 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border: 1px solid var(--border-glow); }
        .top-bar { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--border-glow); padding-bottom: 20px; margin-bottom: 25px; }
        .profile-title h1 { margin: 0; font-size: 2rem; color: var(--accent-neon); letter-spacing: 1px; }
        .profile-title p { margin: 5px 0 0 0; color: var(--text-secondary); font-size: 1.05rem; font-weight: 600; }
        .mode-toggle { background: linear-gradient(135deg, var(--accent-neon), var(--accent-rose)); color: white; border: none; padding: 10px 18px; border-radius: 30px; font-weight: bold; cursor: pointer; transition: transform 0.2s; }
        .mode-toggle:hover { transform: scale(1.05); }
        
        .nordic-alert { background: rgba(56, 189, 248, 0.1); border-left: 5px solid var(--accent-neon); padding: 18px; border-radius: 8px; margin-bottom: 25px; font-size: 0.95rem; }
        
        h2 { color: var(--text-primary); font-size: 1.3rem; border-bottom: 1px dashed var(--border-glow); padding-bottom: 6px; margin-top: 30px; text-transform: uppercase; letter-spacing: 1px; }
        
        .showcase-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 15px; }
        @media(min-width: 650px) { .showcase-grid { grid-template-columns: 1fr 1fr; } }
        
        .card-item { background: var(--bg-base); border: 1px solid var(--border-glow); padding: 20px; border-radius: 14px; transition: all 0.3s ease; }
        .card-item:hover { border-color: var(--accent-neon); transform: translateY(-3px); box-shadow: 0 6px 20px rgba(56, 189, 248, 0.15); }
        .card-item h3 { margin-top: 0; margin-bottom: 10px; font-size: 1.15rem; }
        .card-item h3 a { color: var(--accent-neon); text-decoration: none; }
        .card-item h3 a:hover { text-decoration: underline; }
        .card-item p { font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 15px; }
        
        .pill { display: inline-block; background: var(--surface-color); color: var(--accent-neon); border: 1px solid var(--accent-neon); padding: 3px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: bold; margin-right: 5px; margin-bottom: 5px; }
        
        .contact-box { background: var(--bg-base); padding: 20px; border-radius: 12px; border: 1px solid var(--border-glow); }
        .contact-box p { margin: 8px 0; font-size: 0.95rem; word-break: break-all; }
    </style>
</head>
<body data-theme="dark">

<div class="wrapper">
    <!-- Header Section -->
    <div class="top-bar">
        <div class="profile-title">
