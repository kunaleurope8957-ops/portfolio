<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nordic Freedom & Relocation Master Dashboard 🇩🇰🇪🇺</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen pb-12">

  <!-- 🚀 TOP NAVIGATION BAR -->
  <header class="sticky top-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-800 px-6 py-4 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-red-600 to-rose-400 flex items-center justify-center font-black text-xl shadow-lg shadow-red-500/20">
        🇩🇰
      </div>
      <div>
        <h1 class="text-lg font-black text-white tracking-wide">EUROPE RELOCATION HUB</h1>
        <p class="text-xs text-slate-400 font-mono">Target: Feb 2027 • Copenhagen & Nordic Region</p>
      </div>
    </div>
    <div class="flex items-center gap-4 text-xs font-mono">
      <div class="bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-xl text-teal-400 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
        Sprint: 60 Days Active
      </div>
    </div>
  </header>

  <!-- 📊 MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 md:px-8 mt-8 space-y-8">

    <!-- 1️⃣ HERO BANNER & DAY COUNTER -->
    <section class="bg-gradient-to-r from-slate-900 via-slate-900 to-slate-800 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="text-xs font-mono font-bold uppercase tracking-widest text-teal-400">Mission Independence</span>
        <h2 class="text-2xl md:text-4xl font-black text-white">Full Freedom & New Life Blueprint</h2>
        <p class="text-sm text-slate-400 max-w-xl">
          Build tech skills, master Danish, manage relocation finances, and track daily execution toward Copenhagen 2027.
        </p>
      </div>
      <div class="bg-slate-950/80 border border-teal-500/30 p-5 rounded-2xl text-center min-w-[200px]">
        <span class="text-xs text-slate-400 font-mono block mb-1">Target Horizon</span>
        <span class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-400 font-mono">FEB 2027</span>
        <span class="text-[10px] text-teal-300/80 block mt-1 font-mono">Nordic Tech Pathway</span>
      </div>
    </section>

    <!-- 2️⃣ GRID: HABIT TRACKER & CURRENCY CONVERTER -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- 📋 DAILY 60-DAY HABIT & SKILL TRACKER -->
      <section class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
            <h3 class="font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-list-check text-teal-400"></i> Daily Execution Checklist
            </h3>
            <span id="progressPercent" class="text-xs font-mono bg-teal-950 text-teal-300 border border-teal-800 px-2.5 py-1 rounded-lg">0% Done</span>
          </div>

          <!-- Progress Bar -->
          <div class="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden mb-6">
            <div id="progressBar" class="bg-gradient-to-r from-teal-500 to-cyan-400 h-full w-0 transition-all duration-300"></div>
          </div>

          <!-- Checklist Items -->
          <div class="space-y-3 text-sm">
            <label class="flex items-center gap-3 bg-slate-800/40 border border-slate-800 p-3.5 rounded-2xl cursor-pointer hover:border-slate-700 transition">
              <input type="checkbox" onchange="updateProgress()" class="habit-check w-4 h-4 accent-teal-500 rounded">
              <span>💻 Web Dev Coding (HTML/CSS/JS Project Work)</span>
            </label>
            <label class="flex items-center gap-3 bg-slate-800/40 border border-slate-800 p-3.5 rounded-2xl cursor-pointer hover:border-slate-700 transition">
              <input type="checkbox" onchange="updateProgress()" class="habit-check w-4 h-4 accent-teal-500 rounded">
              <span>🗣️ English Speaking & Fluent Communication Practice</span>
            </label>
            <label class="flex items-center gap-3 bg-slate-800/40 border border-slate-800 p-3.5 rounded-2xl cursor-pointer hover:border-slate-700 transition">
              <input type="checkbox" onchange="updateProgress()" class="habit-check w-4 h-4 accent-teal-500 rounded">
              <span>🇩🇰 Danish Vocabulary Practice (10 Words)</span>
            </label>
            <label class="flex items-center gap-3 bg-slate-800/40 border border-slate-800 p-3.5 rounded-2xl cursor-pointer hover:border-slate-700 transition">
              <input type="checkbox" onchange="updateProgress()" class="habit-check w-4 h-4 accent-teal-500 rounded">
              <span>🚀 GitHub Commit & Push Operations</span>
            </label>
          </div>
        </div>

        <p class="text-xs text-slate-500 font-mono mt-4">* Complete all 4 daily tasks to maintain consistency.</p>
      </section>

      <!-- 💱 LIVE RELOCATION BUDGET & CURRENCY CALCULATOR -->
      <section class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-5">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <h3 class="font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-calculator text-cyan-400"></i> Relocation & Living Cost Calculator
          </h3>
          <span class="text-xs text-slate-400 font-mono">INR / DKK / EUR</span>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-xs font-mono text-slate-400 mb-1">Enter Monthly Savings/Budget (INR ₹)</label>
            <input type="number" id="inrValue" value="100000" oninput="calculateRelocation()" class="w-full bg-slate-950 border border-slate-700 rounded-xl p-3 text-sm font-mono text-teal-300 focus:outline-none focus:border-teal-500">
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="bg-slate-800/60 border border-slate-800 p-4 rounded-2xl">
              <span class="text-xs text-slate-400 font-mono block">Danish Krone (DKK)</span>
              <span id="dkkVal" class="text-xl font-bold font-mono text-teal-400">8,333 kr</span>
            </div>
            <div class="bg-slate-800/60 border border-slate-800 p-4 rounded-2xl">
              <span class="text-xs text-slate-400 font-mono block">Euro (EUR)</span>
              <span id="eurVal" class="text-xl font-bold font-mono text-cyan-400">€1,111</span>
            </div>
          </div>

          <!-- Benchmark Expenses -->
          <div class="bg-slate-950/60 p-4 rounded-2xl border border-slate-800/80 space-y-2 text-xs font-mono">
            <div class="flex justify-between text-slate-400">
              <span>Avg. Rent (Copenhagen):</span>
              <span class="text-white">~5,500 DKK</span>
            </div>
            <div class="flex justify-between text-slate-400">
              <span>Food & Groceries:</span>
              <span class="text-white">~2,200 DKK</span>
            </div>
            <div class="flex justify-between text-teal-400 font-bold pt-2 border-t border-slate-800">
              <span>Total Estimated Living Cost:</span>
              <span>~8,500 DKK/mo</span>
            </div>
          </div>
        </div>
      </section>

    </div>

    <!-- 3️⃣ DANISH FLASHCARD ENGINE -->
    <section class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
        <div>
          <h3 class="font-bold text-white text-lg flex items-center gap-2">
            <i class="fa-solid fa-language text-rose-400"></i> Interactive Danish Booster
          </h3>
          <p class="text-xs text-slate-400 font-mono">Click any card to reveal the English translation</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        
        <div onclick="toggleFlash(this)" class="bg-slate-800/50 border border-slate-700/60 p-5 rounded-2xl cursor-pointer hover:border-rose-500/50 transition">
          <span class="text-[10px] font-mono text-rose-400 uppercase font-bold tracking-wider">Transit</span>
          <h4 class="text-lg font-bold text-white mt-1">Hvor er metroen?</h4>
          <p class="text-xs text-slate-400 italic font-mono mt-1">Pron: Vohr er meh-tro-en?</p>
          <div class="flash-meaning hidden mt-3 pt-3 border-t border-slate-700 text-xs font-semibold text-teal-300">
            🇬🇧 "Where is the metro?"
          </div>
        </div>

        <div onclick="toggleFlash(this)" class="bg-slate-800/50 border border-slate-700/60 p-5 rounded-2xl cursor-pointer hover:border-rose-500/50 transition">
          <span class="text-[10px] font-mono text-rose-400 uppercase font-bold tracking-wider">Daily Phrase</span>
          <h4 class="text-lg font-bold text-white mt-1">Mange tak for hjælpen!</h4>
          <p class="text-xs text-slate-400 italic font-mono mt-1">Pron: Mahn-geh tahk for hyelp-en!</p>
          <div class="flash-meaning hidden mt-3 pt-3 border-t border-slate-700 text-xs font-semibold text-teal-300">
            🇬🇧 "Thank you very much for the help!"
          </div>
        </div>

        <div onclick="toggleFlash(this)" class="bg-slate-800/50 border border-slate-700/60 p-5 rounded-2xl cursor-pointer hover:border-rose-500/50 transition">
          <span class="text-[10px] font-mono text-rose-400 uppercase font-bold tracking-wider">Workplace</span>
          <h4 class="text-lg font-bold text-white mt-1">Jeg arbejder med IT</h4>
          <p class="text-xs text-slate-400 italic font-mono mt-1">Pron: Yay ar-bay-der meh IT</p>
          <div class="flash-meaning hidden mt-3 pt-3 border-t border-slate-700 text-xs font-semibold text-teal-300">
            🇬🇧 "I work in IT / Web Tech"
          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- 📜 JAVASCRIPT LOGIC -->
  <script>
    // Habit Tracker Logic
    function updateProgress() {
      const checks = document.querySelectorAll('.habit-check');
      let checkedCount = 0;
      checks.forEach(c => { if(c.checked) checkedCount++; });
      const percent = Math.round((checkedCount / checks.length) * 100);
      document.getElementById('progressBar').style.width = percent + '%';
      document.getElementById('progressPercent').innerText = percent + '% Done';
    }

    // Currency Conversion Logic
    function calculateRelocation() {
      const inr = parseFloat(document.getElementById('inrValue').value) || 0;
      const dkk = (inr / 12.0).toFixed(0);
      const eur = (inr / 90.0).toFixed(0);
      document.getElementById('dkkVal').innerText = Number(dkk).toLocaleString() + ' kr';
      document.getElementById('eurVal').innerText = '€' + Number(eur).toLocaleString();
    }

    // Flashcard Flip Logic
    function toggleFlash(card) {
      const meaning = card.querySelector('.flash-meaning');
      meaning.classList.toggle('hidden');
    }

    // Initial load runs
    calculateRelocation();
  </script>

</body>
</html>
