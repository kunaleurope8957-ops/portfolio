const express = require('express');
const app = express();
const PORT = process.env.PORT || 3000;

// Standard Middleware for parsing incoming JSON requests
app.use(express.json());

// Mock Database: Hardcoded European Market Intelligence Data
const euroMarketData = [
    { id: 1, country: "Norway", currency: "NOK", avgDeveloperSalaryEUR: 62000, workLifeBalanceRating: "4.8/5", visaSponsorshipAvailable: true },
    { id: 2, country: "Sweden", currency: "SEK", avgDeveloperSalaryEUR: 54000, workLifeBalanceRating: "4.7/5", visaSponsorshipAvailable: true },
    { id: 3, country: "Denmark", currency: "DKK", avgDeveloperSalaryEUR: 66000, workLifeBalanceRating: "4.9/5", visaSponsorshipAvailable: true },
    { id: 4, country: "Finland", currency: "EUR", avgDeveloperSalaryEUR: 51000, workLifeBalanceRating: "4.8/5", visaSponsorshipAvailable: true },
    { id: 5, country: "Netherlands", currency: "EUR", avgDeveloperSalaryEUR: 59000, workLifeBalanceRating: "4.6/5", visaSponsorshipAvailable: true }
];

// Global Logging Middleware for Enterprise-level request auditing
app.use((req, res, next) => {
    console.log(`[AUDIT] ${new Date().toISOString()} - ${req.method} request received at ${req.url}`);
    next();
});

/**
 * @route   GET /
 * @desc    Root System Health Check Endpoint
 * @access  Public
 */
app.get('/', (req, res) => {
    res.status(200).json({
        status: "success",
        message: "Euro-Dashboard Core Engine is fully operational.",
        environment: "production-ready",
        timestamp: new Date()
    });
});

/**
 * @route   GET /api/v1/market
 * @desc    Fetch comprehensive market metrics for all targeted EU destinations
 * @access  Public
 */
app.get('/api/v1/market', (req, res) => {
    try {
        res.status(200).json({
            success: true,
            count: euroMarketData.length,
            metadata: {
                region: "Nordics & Western Europe",
                currencyBase: "EUR / Local Peg"
            },
            data: euroMarketData
        });
    } catch (error) {
        res.status(500).json({
            success: false,
            error: "Internal Server Error",
            message: error.message
        });
    }
});

/**
 * @route   GET /api/v1/market/search
 * @desc    Dynamically filter telemetry metrics by specific country query strings
 * @access  Public
 * @example /api/v1/market/search?country=Sweden
 */
app.get('/api/v1/market/search', (req, res) => {
    try {
        const queryCountry = req.query.country;

        if (!queryCountry) {
            return res.status(400).json({
                success: false,
                error: "Bad Request",
                message: "Missing mandatory query parameter: 'country'."
            });
        }

        const targetDestination = euroMarketData.find(
            dest => dest.country.toLowerCase() === queryCountry.toLowerCase()
        );

        if (!targetDestination) {
            return res.status(404).json({
                success: false,
                error: "Not Found",
                message: `No active telemetry profile found for destination: '${queryCountry}'.`
            });
        }

        res.status(200).json({
            success: true,
            data: targetDestination
        });

    } catch (error) {
        res.status(500).json({
            success: false,
            error: "Execution Failure",
            message: error.message
        });
    }
});

// Centralized 404 Fallback Router for unhandled routes
app.use((req, res) => {
    res.status(404).json({
        success: false,
        error: "Route Not Found",
        message: "The requested application route does not exist on this server instance."
    });
});

// Primary Server Listener initialization
app.listen(PORT, () => {
    console.log(`\n=============================================================`);
    console.log(`📡 ENTERPRISE ENGINE ACTIVE: http://localhost:${PORT}`);
    console.log(`🚀 Architecture Level: Production-Ready (International Standards)`);
    console.log(`=============================================================\n`);
});
